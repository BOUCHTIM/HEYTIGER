# ── Booking (src/lib/booking) ───────────────────────────────────────────────
# Server-only: none of these are NEXT_PUBLIC_, the browser never sees them.
# With no SevenRooms credentials the form runs on the mock in development and
# shows phone/email options in production ("offline"), so no guest is ever told
# they hold a table the venue hasn't seen.

# SevenRooms Reservation API — credentials come from SevenRooms (venue rep / partner programme).
SEVENROOMS_CLIENT_ID=
SEVENROOMS_CLIENT_SECRET=
# Opaque venue key from SevenRooms (not the slug).
SEVENROOMS_VENUE_ID=
# Optional. Defaults to https://api.sevenrooms.com/2_4 — use https://demo.sevenrooms.com/api-ext/2_2 for the demo sandbox.
SEVENROOMS_API_BASE=
# Public venue slug, used for the hosted fallback page https://www.sevenrooms.com/reservations/<slug>
SEVENROOMS_VENUE_SLUG=

# Optional overrides
# BOOKING_PROVIDER=mock            # force the mock (e.g. on Vercel previews)
# BOOKING_MAX_PARTY_SIZE=12
# BOOKING_LARGE_PARTY_THRESHOLD=8
# BOOKING_WINDOW_DAYS=60
# BOOKING_TIMEZONE=Asia/Dubai
